# ===========================================================================
# AI Phone Interpreter (English / Telugu / Tamil / Hindi) - configuration
# Copy to .env (start.bat does this for you). Never commit .env.
# EVERYTHING IS OPTIONAL: with no keys at all the app still works using
#   * Chrome's built-in speech recognition (free)
#   * Google free / MyMemory translation (free, no key)
#   * Edge TTS neural voices (free, needs `pip install edge-tts`), then the
#     Google Translate voice, then the device's own voice
# Azure keys (free F0 tiers) give better voices and a server-side STT option.
# ===========================================================================

# ---- Provider choice: "auto" picks the best configured option -------------
STT_PROVIDER=auto            # auto | browser | azure | mock
TRANSLATE_PROVIDER=auto      # auto | azure | google_free | mymemory | mock  (or a comma list, tried in order)
TTS_PROVIDER=auto            # auto = azure(if key) -> edge(if installed) -> google -> browser
                             # or a comma list, e.g.  edge,google,browser

# ---- Azure Speech (STT + neural TTS, free F0: 5 h STT + 0.5M chars TTS / month)
# Portal -> your *Speech* resource -> "Keys and Endpoint": KEY 1 and Location/Region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=         # e.g. centralindia  (the resource's Location, lowercase, no spaces)
# AZURE_VOICE_TE=te-IN-ShrutiNeural   # or te-IN-MohanNeural
# AZURE_VOICE_EN=en-IN-NeerjaNeural   # or en-IN-PrabhatNeural, en-US-JennyNeural
# AZURE_VOICE_TA=ta-IN-PallaviNeural  # or ta-IN-ValluvarNeural
# AZURE_VOICE_HI=hi-IN-SwaraNeural    # or hi-IN-MadhurNeural
# (these voice names are used by both Azure and Edge TTS)

# ---- Azure AI Translator (free F0: 2M characters / month) -------------------
# Portal -> your *Translator* resource -> "Keys and Endpoint".
#   KEY 1                      -> AZURE_TRANSLATOR_KEY
#   Location/Region            -> AZURE_TRANSLATOR_REGION
#   If Location says "Global", leave AZURE_TRANSLATOR_REGION EMPTY.
# A wrong/missing region is the #1 cause of error 401001. Diagnose with:
#   python scripts/stage1_probe.py --translator-diagnose
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ---- Free translation fallbacks (no key needed) -----------------------------
# MYMEMORY_EMAIL=you@example.com     # optional: raises MyMemory's free quota 5k -> 50k chars/day

# ---- ElevenLabs (optional; free plan is only ~10 min of speech per month) ----
# Use a *premade* voice id (community "library" voices need a paid plan via API).
# Telugu needs ELEVENLABS_MODEL=eleven_v3 (the default). Add "elevenlabs" to TTS_PROVIDER to use it.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=
# ELEVENLABS_MODEL=eleven_v3

# ---- Server ----------------------------------------------------------------
HTTP_PORT=8000               # laptop:  http://localhost:8000
HTTPS_PORT=8443              # phone:   https://<laptop-ip>:8443
PROVIDER_TIMEOUT_S=10
LOG_LEVEL=info
